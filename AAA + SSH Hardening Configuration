! === Step 1: Basic SSH prerequisites ===
hostname R1
ip domain-name lab.local
crypto key generate rsa modulus 2048
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
! === Step 2: Create local fallback user ===
username admin privilege 15 algorithm-type scrypt secret Str0ngP@ss!
username readonly privilege 5 algorithm-type scrypt secret Read0nly!
!
! === Step 3: Enable AAA + RADIUS ===
aaa new-model
radius server RADIUS-SRV
address ipv4 192.168.10.100 auth-port 1812 acct-port 1813
key R@d1usK3y!
!
aaa group server radius RADIUS-GROUP
server name RADIUS-SRV
!
! Try RADIUS first, fall back to local if server unreachable
aaa authentication login default group RADIUS-GROUP local
aaa authorization exec default group RADIUS-GROUP local if-authenticated
aaa accounting exec default start-stop group RADIUS-GROUP
!
! === Step 4: Lock down VTY to SSH only ===
line vty 0 15
login authentication default
transport input ssh
exec-timeout 10 0
logging synchronous
!
! === Step 5: Disable unnecessary services ===
no service finger
no service pad
no ip http server
no ip http secure-server
no cdp run
service password-encryption

## VERIFICATION COMMANDS ##
show aaa servers
show aaa sessions
debug aaa authentication
show users
show ip ssh
ssh -l admin 192.168.1.1
! RADIUS server status + round-trip times
! active AAA sessions
! live auth flow (disable after testing)
! logged-in users + line
! SSH version, timeout, retries
! test from another device
